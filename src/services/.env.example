# Cloudinary Configuration
# Get these values from your Cloudinary dashboard at https://cloudinary.com/

# Required - Your Cloudinary cloud name (found in Cloudinary Dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Required - Upload preset (create in Cloudinary Settings > Upload > Add upload preset)
# Make sure to set it to "Unsigned" for client-side uploads
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional - Folder name for uploaded images (default: products)
VITE_CLOUDINARY_FOLDER=products

# To configure Cloudinary:
# 1. Go to https://cloudinary.com/ and create an account
# 2. Go to Dashboard to find your Cloud Name
# 3. Go to Settings > Upload > Add upload preset
# 4. Set the preset to "Unsigned" mode
# 5. Copy the preset name to VITE_CLOUDINARY_UPLOAD_PRESET

